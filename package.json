    "test:e2e": "playwright test",
    "peer-server": "node scripts/peer-server.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.187.0",
    "peer": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
