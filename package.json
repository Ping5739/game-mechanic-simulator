{
  "name": "game-mechanic-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based encounter practice simulator with peer-to-peer multiplayer, bots and (later) log replay.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ping5739/game-mechanic-simulator.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
